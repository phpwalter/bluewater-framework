{
    "name": "bluewater/framework",
    "description": "Bluewater 8 lightweight, convention-first API framework",
    "type": "library",
    "license": "OSL-3.0",
    "require": {
        "php": ">=8.3",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Bluewater\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bluewater\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "@php -l examples/host/public/app_1/index.php",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
