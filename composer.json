{
    "name": "bluewater/framework",
    "description": "Bluewater 8 lightweight, convention-first API framework",
    "type": "library",
    "license": "OSL-3.0",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Bluewater\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bluewater\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src examples tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "style": "phpcs --standard=phpcs.xml.dist",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
        "test": "phpunit",
        "check": [
            "@lint",
            "@style",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
